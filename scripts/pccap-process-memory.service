[Unit]
Description=pc_cap process memory history and crash evidence

[Service]
Type=simple
ExecStart=/home/derp/cap/venv/bin/python -B /home/derp/cap/pc_cap/scripts/process_memory_monitor.py record
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=73 74
TimeoutStopSec=20
Nice=5
UMask=0077
NoNewPrivileges=true
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=default.target
