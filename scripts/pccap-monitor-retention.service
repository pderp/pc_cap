[Unit]
Description=Expire pc_cap monitor logs older than 48 hours using logrotate

[Service]
Type=oneshot
ExecStart=/home/derp/cap/venv/bin/python -B /home/derp/cap/pc_cap/scripts/monitor_log_retention.py --apply --retention-hours 48
TimeoutStartSec=45
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
MemoryMax=128M
